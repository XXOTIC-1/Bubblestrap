<ui:UiPage x:Class="Bloxstrap.UI.Elements.Settings.Pages.RiskyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:resources="clr-namespace:Bloxstrap.Resources"
      xmlns:controls="clr-namespace:Bloxstrap.UI.Elements.Controls"
      xmlns:dmodels="clr-namespace:Bloxstrap.UI.ViewModels.Settings"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance dmodels:RiskyViewModel, IsDesignTimeCreatable=True}"
      d:DesignHeight="600" d:DesignWidth="800"
      Title="RiskyPage"
      Scrollable="True">
    <StackPanel Margin="0,0,14,14">
        <ui:InfoBar Margin="0,0,0,12" Padding="8" Severity="Warning" IsOpen="True" IsClosable="False"
                    Title="{x:Static resources:Strings.Menu_Risky_Warning_Title}"
                    Message="{x:Static resources:Strings.Menu_Risky_Warning_Message}" />

        <controls:OptionControl
            Header="{x:Static resources:Strings.Menu_Risky_Acknowledge_Title}"
            Description="{x:Static resources:Strings.Menu_Risky_Acknowledge_Description}">
            <ui:ToggleSwitch IsChecked="{Binding Acknowledged, Mode=TwoWay}" />
        </controls:OptionControl>

        <StackPanel IsEnabled="{Binding Acknowledged, Mode=OneWay}">
            <TextBlock Text="{x:Static resources:Strings.Menu_Risky_Visual_Title}" FontSize="16" FontWeight="Medium" Margin="0,16,0,0" />

            <controls:OptionControl
                Header="{x:Static resources:Strings.Menu_Risky_Fullbright_Title}"
                Description="{x:Static resources:Strings.Menu_Risky_Fullbright_Description}">
                <ui:ToggleSwitch IsChecked="{Binding Fullbright, Mode=TwoWay}" />
            </controls:OptionControl>

            <controls:OptionControl
                Header="{x:Static resources:Strings.Menu_Risky_Wireframe_Title}"
                Description="{x:Static resources:Strings.Menu_Risky_Wireframe_Description}">
                <ui:ToggleSwitch IsChecked="{Binding Wireframe, Mode=TwoWay}" />
            </controls:OptionControl>

            <controls:OptionControl
                Header="{x:Static resources:Strings.Menu_Risky_SkipMeshVoxelizer_Title}"
                Description="{x:Static resources:Strings.Menu_Risky_SkipMeshVoxelizer_Description}">
                <ui:ToggleSwitch IsChecked="{Binding SkipMeshVoxelizer, Mode=TwoWay}" />
            </controls:OptionControl>
        </StackPanel>
    </StackPanel>
</ui:UiPage>
