<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Tuffstrap black & gold palette (overrides WPF UI dark theme) -->
    <Color x:Key="TuffstrapGoldColor">#FFC9A227</Color>
    <Color x:Key="TuffstrapGoldLightColor">#FFE8C547</Color>
    <Color x:Key="TuffstrapGoldMutedColor">#FF8A7420</Color>
    <SolidColorBrush x:Key="TuffstrapGoldBrush" Color="{StaticResource TuffstrapGoldColor}" />
    <SolidColorBrush x:Key="TuffstrapGoldLightBrush" Color="{StaticResource TuffstrapGoldLightColor}" />
    <SolidColorBrush x:Key="TuffstrapGoldMutedBrush" Color="{StaticResource TuffstrapGoldMutedColor}" />
    <SolidColorBrush x:Key="TuffstrapSurfaceBrush" Color="#FF121212" />
    <SolidColorBrush x:Key="TuffstrapSurfaceElevatedBrush" Color="#FF1A1A1A" />
    <SolidColorBrush x:Key="TuffstrapDividerBrush" Color="#33C9A227" />

    <Color x:Key="ApplicationBackgroundColor">#FF0A0A0A</Color>
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="{StaticResource ApplicationBackgroundColor}" />

    <Color x:Key="SolidBackgroundFillColorBase">#0A0A0A</Color>
    <Color x:Key="SolidBackgroundFillColorSecondary">#121212</Color>
    <Color x:Key="SolidBackgroundFillColorTertiary">#181818</Color>
    <Color x:Key="SolidBackgroundFillColorQuarternary">#1E1E1E</Color>
    <Color x:Key="SolidBackgroundFillColorBaseAlt">#050505</Color>

    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{StaticResource SolidBackgroundFillColorBase}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="{StaticResource SolidBackgroundFillColorSecondary}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondarybrush" Color="{StaticResource SolidBackgroundFillColorSecondary}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="{StaticResource SolidBackgroundFillColorTertiary}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorQuarternaryBrush" Color="{StaticResource SolidBackgroundFillColorQuarternary}" />

    <Color x:Key="ControlFillColorDefault">#12C9A227</Color>
    <Color x:Key="ControlFillColorSecondary">#18C9A227</Color>
    <Color x:Key="ControlFillColorInputActive">#CC141414</Color>
    <Color x:Key="CardBackgroundFillColorDefault">#10FFFFFF</Color>
    <Color x:Key="CardStrokeColorDefaultSolid">#FF1F1B12</Color>
    <Color x:Key="DividerStrokeColorDefault">#22C9A227</Color>
    <Color x:Key="ControlStrokeColorDefault">#28C9A227</Color>

    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="{StaticResource ControlFillColorDefault}" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="{StaticResource ControlFillColorSecondary}" />
    <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="{StaticResource ControlFillColorInputActive}" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource CardBackgroundFillColorDefault}" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultSolidBrush" Color="{StaticResource CardStrokeColorDefaultSolid}" />
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="{StaticResource DividerStrokeColorDefault}" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="{StaticResource ControlStrokeColorDefault}" />

    <Color x:Key="TextOnAccentFillColorPrimary">#FF0A0A0A</Color>
    <Color x:Key="TextOnAccentFillColorSelectedText">#FF0A0A0A</Color>
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="{StaticResource TextOnAccentFillColorPrimary}" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSelectedTextBrush" Color="{StaticResource TextOnAccentFillColorSelectedText}" />

    <SolidColorBrush x:Key="NewTextEditorBackground" Color="#FF141414" />
    <SolidColorBrush x:Key="NewTextEditorForeground" Color="#FFF5F0E6" />
    <SolidColorBrush x:Key="NewTextEditorLink" Color="#FFC9A227" />

    <Style x:Key="SquareProgressBarStyle" TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid Name="TemplateRoot" SnapsToDevicePixels="True">
                        <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="0" />

                        <Rectangle Name="PART_Track" />

                        <Border Name="PART_Indicator"
                            HorizontalAlignment="Left"
                            Background="{TemplateBinding Foreground}"
                            CornerRadius="0" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsIndeterminate" Value="True">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ProgressBar">
                            <ControlTemplate.Resources>
                                <Storyboard x:Key="IndeterminateAnim" RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetName="PART_GlowRect"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                 From="-200" To="800" Duration="0:0:4" />
                                </Storyboard>
                            </ControlTemplate.Resources>

                            <Grid Name="TemplateRoot" ClipToBounds="True">
                                <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="0" />

                                <Grid Name="AnimationContainer" ClipToBounds="True">
                                    <Border Name="PART_GlowRect"
                                        Width="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, TargetNullValue=100}"
                                        Height="{TemplateBinding Height}"
                                        HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}"
                                        CornerRadius="0">
                                        <Border.RenderTransform>
                                            <TranslateTransform X="-200" />
                                        </Border.RenderTransform>
                                    </Border>
                                </Grid>
                            </Grid>

                            <ControlTemplate.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard Storyboard="{StaticResource IndeterminateAnim}" />
                                </EventTrigger>
                            </ControlTemplate.Triggers>

                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
